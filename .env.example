# Pick ONE provider: groq | gemini | huggingface | nvidia | openrouter
SRE_PROVIDER=groq
# Optional override. Defaults: groq=openai/gpt-oss-120b, gemini=gemini-2.5-flash, huggingface=Qwen/Qwen2.5-72B-Instruct, nvidia=nvidia/nemotron-3-ultra-550b-a55b, openrouter=google/gemma-4-31b-it
SRE_MODEL=
GROQ_API_KEY=
GOOGLE_API_KEY=
HUGGINGFACEHUB_API_TOKEN=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# SRE_NAMESPACE=            # overrides `namespace` in system.yaml
SRE_DRY_RUN=false                 # true = write tools only print what they would run
# Host-mapped ports from your kind-config.yaml (kubectl port-forward also works)
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200
# Eval harness only (eval/target.py): the test target's repo (contains fault-injection/), or set SRE_SCENARIO_DIR + SRE_FAULT_CMD directly
SRE_EVAL_DIR=../playground
# SRE_FAULT_CMD=python path/to/faultctl.py     # called as: <cmd> inject|recover <scenario>
# SRE_KUBECTL=kubectl                          # e.g. "kubectl --context my-cluster" or "oc"
# Grader for the eval: use a DIFFERENT model than the agent so it does not grade itself
# SRE_JUDGE_PROVIDER=
# SRE_JUDGE_MODEL=
SRE_LOG_LEVEL=INFO      # DEBUG = also show model reasoning + full tool output
SRE_LOG_DIR=logs
# Optional: a different (e.g. cheaper) model for the spawned subagents (inspectors + remediator). Unset = same as the main agent.
SRE_SUBAGENT_PROVIDER=
SRE_SUBAGENT_MODEL=
# Default techniques when a run does not choose its own (CLI --features, console toggles and the eval harness override these)
SRE_LOCALIZER=false     # deterministic suspect ranking injected into the first message
SRE_FALSIFY=false       # prompt-only: refute each claim with one cheap check before digging deeper
SRE_MEMORY=true         # incident memory (RAG)
SRE_HYPOTHESIS=false    # competing hypotheses in a code-scored ledger; a fix is refused until one cause is confirmed (sre_agent/hypothesis.py)
# Seconds to wait for ONE model response before it counts as a timeout (then retried). Raise for slow/large models.
SRE_LLM_TIMEOUT=180

# Numbers behind the techniques (optional; the console's Advanced options and --tuning override these per run). Ranges: sre_agent/tuning.py
# SRE_TOOL_BUDGET=30        # budget: investigation tool calls per incident
# SRE_INSPECTOR_CALLS=8     # "at most N tool calls" in each inspector's prompt
# SRE_REPORT_WORDS=150      # compact_reports: words per inspector report
# SRE_LOG_PATTERNS=12       # cluster_logs: patterns shown per search_logs
# SRE_LOG_FETCH=100         # cluster_logs: lines fetched per search_logs
# SRE_PREFLIGHT_CHARS=3200  # preflight: size cap of the block
# SRE_RECURSION_LIMIT=120   # graph steps before a run is aborted
# SRE_HYPOTHESIS_MIN_SIGNALS=2   # hypothesis: different signal types (metrics/logs/traces/cluster) that must confirm a hypothesis
# SRE_HYPOTHESIS_MIN_COUNT=2     # hypothesis: competing hypotheses required before a diagnosis can be confirmed
# SRE_HYPOTHESIS_REFUTE_MIN=1    # hypothesis: observations that must violate a prediction to refute a hypothesis
# SRE_HYPOTHESIS_GATE=1          # hypothesis: 0 = the remediation gate only advises, it does not block
